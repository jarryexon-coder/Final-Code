{
  "name": "nba-backend-tests",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules test/run-tests.js",
    "test:integration": "mocha test/integration/*.test.js --timeout 10000 --exit",
    "test:unit": "mocha test/unit/*.test.js",
    "test:watch": "mocha test/**/*.test.js --watch",
    "test:coverage": "nyc mocha test/**/*.test.js",
    "test:ci": "npm run test -- --reporter json > test-results.json"
  },
  "dependencies": {
    "supertest": "^6.3.3",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "node-fetch": "^3.3.2",
    "nyc": "^15.1.0"
  }
}
