{
  "name": "nba-fantasy-ai-backend",
  "version": "5.0.0",
  "description": "NBA Fantasy AI Backend with all enhancements",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS='--max-old-space-size=4096' node server.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' nodemon server.js",
    "build": "echo 'No build step required for Node.js backend'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "docs:generate": "node scripts/generate-swagger.js",
    "logs": "tail -f logs/combined.log",
    "redis:flush": "node scripts/flush-redis.js"
  },
  "keywords": [
    "nba",
    "fantasy",
    "ai",
    "api",
    "redis",
    "monitoring",
    "swagger"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.55.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-status-monitor": "^1.3.4",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "node-schedule": "^2.1.1",
    "redis": "^4.6.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
