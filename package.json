{
  "name": "nba-fantasy-ai-backend",
  "version": "5.0.0",
  "description": "NBA Fantasy AI Backend with Authentication",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS='--max-old-space-size=4096' node server.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:auth": "curl http://localhost:3002/api/auth",
    "test:health": "curl http://localhost:3002/health",
    "railway": "NODE_OPTIONS='--max-old-space-size=4096' node server.js",
    "deploy": "git push origin main"
  },
  "keywords": [
    "nba",
    "fantasy",
    "ai",
    "authentication",
    "express",
    "mongodb",
    "firebase",
    "stripe",
    "socket.io"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^8.2.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.0.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
