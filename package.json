{
  "name": "nba-fantasy-ai-backend",
  "version": "5.0.0",
  "description": "NBA Fantasy AI Backend with Secret Phrase Analytics & Premium Features",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "PORT=3002 node server.js",
    "dev": "nodemon server.js",
    "server": "node server.js",
    "legacy": "node index.js",  
    "test": "curl http://localhost:3000/health",
    "test:endpoints": "curl http://localhost:3000/health && curl http://localhost:3000/api/players && curl http://localhost:3000/api/teams",
    "test:phase4": "node test-phase4.js",
    "test:phase5": "node test-phase5.js",
    "test:social": "node test-social.js",
    "test:handlers": "node test-handlers.js",
    "test:health": "curl -s http://localhost:3000/health | jq .",
    "test:teams": "curl -s http://localhost:3000/api/teams | jq .",
    "test:all": "npm run test:health && npm run test:teams",
    "test:critical": "curl -s http://localhost:3000/health && curl -s http://localhost:3000/api/players | jq .",
    "test:revenuecat": "node test-revenuecat.js",
    "test:services": "node test_all_services.js",
    "test:analytics": "node test_analytics_endpoints.js",
    "test:situational": "node test_situational_endpoints.js",
    "test:premium": "node test_premium_endpoints.js",
    "test:phrases": "node test_secret_phrases.js",
    "setup:env": "node setup-env.js",
    "security:reset": "node security-reset.js",
    "heroku:deploy": "git add . && git commit -m 'Deploy to Heroku' && git push heroku main",
    "gae:deploy": "gcloud app deploy --quiet",
    "postinstall": "echo '🏀 NBA Fantasy AI Backend v5.0 installed successfully!'",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "monitor": "curl -s http://localhost:3000/health | jq .",
    "generate:services": "node generate_service_templates.js",
    "seed:phrases": "node seed_secret_phrases.js"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "^1.20.0",
    "axios": "^1.13.2",
    "axios-rate-limit": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "express-status-monitor": "^1.3.4",
    "firebase-admin": "^13.6.0",
    "gcp-metadata": "^7.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongodb": "^4.17.2",
    "mongoose": "^9.0.1",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^4.7.1",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "validator": "^13.15.26",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "nba",
    "fantasy",
    "ai",
    "basketball",
    "sports",
    "api",
    "express",
    "socket.io",
    "revenuecat",
    "subscriptions",
    "secret-phrases",
    "analytics",
    "betting",
    "kalshi",
    "draft",
    "gpp",
    "premium"
  ],
  "author": "NBA Fantasy AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/nba-fantasy-ai-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/nba-fantasy-ai-backend/issues"
  },
  "homepage": "https://github.com/yourusername/nba-fantasy-ai-backend#readme"
}
